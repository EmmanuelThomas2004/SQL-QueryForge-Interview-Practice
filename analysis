SELECT E.EmpName, D.DeptName, S.SalaryAmount
FROM Employee E
JOIN Department D ON E.DeptID = D.DeptID
JOIN SalaryHistory S ON E.EmpID = S.EmpID
WHERE S.PayDate = '2026-01-01';

SELECT D.DeptName, AVG(S.SalaryAmount) AS AvgSalary
FROM Department D
JOIN Employee E ON D.DeptID = E.DeptID
JOIN SalaryHistory S ON E.EmpID = S.EmpID
WHERE S.PayDate = '2026-01-01'
GROUP BY D.DeptName;

SELECT E.EmpName, SUM(S.SalaryAmount) AS TotalSalary
FROM Employee E
JOIN SalaryHistory S ON E.EmpID = S.EmpID
GROUP BY E.EmpID, E.EmpName
ORDER BY TotalSalary DESC;

SELECT E.EmpName, S.SalaryAmount
FROM Employee E
JOIN SalaryHistory S ON E.EmpID = S.EmpID
WHERE S.PayDate = '2026-01-01'
AND S.SalaryAmount > (
    SELECT AVG(SalaryAmount)
    FROM SalaryHistory
    WHERE PayDate = '2026-01-01'
);

SELECT D.DeptName, COUNT(E.EmpID) AS EmployeeCount
FROM Department D
LEFT JOIN Employee E ON D.DeptID = E.DeptID
GROUP BY D.DeptName;

SELECT E.EmpName, S.SalaryAmount
FROM Employee E
JOIN SalaryHistory S ON E.EmpID = S.EmpID
WHERE S.PayDate = '2026-01-01'
AND S.SalaryAmount = (
    SELECT MAX(S2.SalaryAmount)
    FROM SalaryHistory S2
    WHERE S2.EmpID = E.EmpID
);

SELECT C.CustomerName, COUNT(O.OrderID) AS OrderCount
FROM Customers C
JOIN Orders O ON C.CustomerID = O.CustomerID
GROUP BY C.CustomerID, C.CustomerName
HAVING COUNT(O.OrderID) > 1;

SELECT C.CustomerName, SUM(O.OrderAmount) AS TotalSpent
FROM Customers C
JOIN Orders O ON C.CustomerID = O.CustomerID
GROUP BY C.CustomerID, C.CustomerName
ORDER BY TotalSpent DESC;

SELECT P.ProductName, SUM(OD.Quantity) AS TotalQuantity
FROM Products P
JOIN OrderDetails OD ON P.ProductID = OD.ProductID
GROUP BY P.ProductID, P.ProductName
ORDER BY TotalQuantity DESC;

SELECT E.EmpName, P.ProjectName, EP.HoursWorked
FROM Employee E
JOIN EmployeeProjects EP ON E.EmpID = EP.EmpID
JOIN Projects P ON EP.ProjectID = P.ProjectID
WHERE EP.HoursWorked > 100;

SELECT E.EmpName, D.DeptName
FROM Employee E
JOIN Department D ON E.DeptID = D.DeptID
WHERE E.DeptID IN (
    SELECT DeptID
    FROM Employee
    GROUP BY DeptID
    HAVING COUNT(*) > 1
);

SELECT E.EmpName, S.SalaryAmount
FROM Employee E
JOIN SalaryHistory S ON E.EmpID = S.EmpID
WHERE S.PayDate = '2026-01-01'
ORDER BY S.SalaryAmount DESC
OFFSET 0 ROWS FETCH NEXT 3 ROWS ONLY;

SELECT O.OrderID, C.CustomerName, O.OrderAmount
FROM Orders O
JOIN Customers C ON O.CustomerID = C.CustomerID
WHERE O.OrderAmount > (
    SELECT AVG(OrderAmount) FROM Orders
);

SELECT P.Category, AVG(P.Price) AS AvgPrice
FROM Products P
GROUP BY P.Category;

SELECT E.EmpName, COUNT(EP.ProjectID) AS ProjectCount
FROM Employee E
LEFT JOIN EmployeeProjects EP ON E.EmpID = EP.EmpID
GROUP BY E.EmpID, E.EmpName;

SELECT D.DeptName, SUM(S.SalaryAmount) AS TotalSalary
FROM Department D
JOIN Employee E ON D.DeptID = E.DeptID
JOIN SalaryHistory S ON E.EmpID = S.EmpID
WHERE S.PayDate = '2026-01-01'
GROUP BY D.DeptName
HAVING SUM(S.SalaryAmount) > 100000;

SELECT E.EmpName, S.SalaryAmount, S.PayDate
FROM Employee E
JOIN SalaryHistory S ON E.EmpID = S.EmpID
WHERE S.PayDate = (
    SELECT MAX(S2.PayDate)
    FROM SalaryHistory S2
    WHERE S2.EmpID = E.EmpID
);

SELECT C.City, COUNT(O.OrderID) AS TotalOrders
FROM Customers C
JOIN Orders O ON C.CustomerID = O.CustomerID
GROUP BY C.City
ORDER BY TotalOrders DESC;

SELECT E.EmpName, A.AttendanceDate, A.Status
FROM Employee E
JOIN Attendance A ON E.EmpID = A.EmpID
WHERE A.Status = 'Absent';

SELECT P.ProjectName, SUM(EP.HoursWorked) AS TotalHours
FROM Projects P
JOIN EmployeeProjects EP ON P.ProjectID = EP.ProjectID
GROUP BY P.ProjectID, P.ProjectName
ORDER BY TotalHours DESC;
